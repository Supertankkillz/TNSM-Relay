{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TNSM Relay",
  "version": "0.1.1",
  "identifier": "com.tnsm.relay.gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TNSM Relay",
        "width": 760,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}